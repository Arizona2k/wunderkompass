{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/learning-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/individual-challenge-hints-2026-10-09": false,
      "codex/master-quality-2026-10-09": false,
      "codex/connected-discoveries-2026-10-09": false,
      "codex/wunderkompass-discovery-2026-10-09": false,
      "codex/wunderkompass-pr-review-rules-2026-10-09": false,
      "codex/wunderkompass-card-design-2026-10-09": false,
      "codex/wunderkompass-pass-2026-10-10": false,
      "codex/wunderkompass-calm-links-2026-10-10": false,
      "codex/wunderkompass-pass-polish-2026-10-10": false,
      "codex/wunderkompass-home-updates-2026-10-10": false,
      "codex/wunderkompass-history-polish-2026-10-11": false,
      "codex/wunderkompass-navigation-2026-10-11": false,
      "codex/wunderkompass-spielplatz-2026-10-11": false,
      "codex/wunderkompass-foundation-2a-2026-10-11": false,
      "codex/wunderkompass-package-2b-2026-10-11": false,
      "codex/wunderkompass-package-2c-2026-10-12": false,
      "codex/wunderkompass-package-3-2026-10-12": false,
      "codex/wunderkompass-excellence-3-5-2026-10-13": false,
      "codex/wunderkompass-excellence-content-2026-10-13": false,
      "codex/wunderkompass-update-chronik-2026-10-16": false
    }
  }
}
