{
  "name": "wunderkompass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/performance-budget.mjs",
    "start": "vite preview --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import ./scripts/test-runtime.mjs --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint app scripts/export-content.mjs scripts/source-constant.mjs scripts/test-runtime.mjs tests/progress.test.mjs tests/browser-suites.test.mjs tests/content-integrity.test.mjs tests/browser/harness.mjs tests/browser/run.mjs tests/browser/suites.mjs tests/browser/smoke.mjs tests/browser/core.mjs tests/browser/offline-cold.mjs tests/browser/engine-journeys.mjs",
    "export:data": "node scripts/export-content.mjs",
    "test:browser": "node tests/browser/run.mjs --suite ci --jobs 2",
    "test:full": "node scripts/export-content.mjs && node tests/browser/run.mjs --suite full",
    "test:smoke": "node tests/browser/run.mjs --suite smoke",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run test:browser",
    "typecheck:fast": "tsc --noEmit --incremental --tsBuildInfoFile work/typecheck.tsbuildinfo",
    "lint:fast": "eslint app scripts/export-content.mjs scripts/source-constant.mjs scripts/test-runtime.mjs tests/progress.test.mjs tests/browser-suites.test.mjs tests/content-integrity.test.mjs tests/browser/harness.mjs tests/browser/run.mjs tests/browser/suites.mjs tests/browser/smoke.mjs tests/browser/core.mjs tests/browser/offline-cold.mjs tests/browser/engine-journeys.mjs"
  },
