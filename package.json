{
  "name": "wunderkompass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/performance-budget.mjs",
    "start": "vite preview --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import ./scripts/test-runtime.mjs --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings 0",
    "export:data": "node scripts/export-content.mjs",
    "test:browser": "node tests/browser/run.mjs --suite ci --jobs 2",
    "test:browser:webkit": "node tests/browser/run.mjs --suite ci --browser webkit --jobs 2 offline-cold backup",
    "test:full": "node scripts/export-content.mjs && node tests/browser/run.mjs --suite full",
    "test:smoke": "node tests/browser/run.mjs --suite smoke",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run test:browser && pnpm run test:browser:webkit",
    "typecheck:fast": "tsc --noEmit --incremental --tsBuildInfoFile work/typecheck.tsbuildinfo",
    "lint:fast": "eslint . --max-warnings 0 --cache --cache-location work/eslint-cache"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/nunito": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "1.31.0",
    "motion": "14.4.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "4.11.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.65.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.16"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
